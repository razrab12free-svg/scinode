rules_version = '2';

// Правила Firestore для Scinode (профили, чат, жалобы, канбан-доски).
// Вставлять целиком: консоль Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid));
    }

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------------------------------------------------------------
    // Профили учёных. Читать могут все вошедшие, писать — только владелец.
    // ---------------------------------------------------------------
    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(
             ['n', 'r', 'o', 'c', 'b', 'orc', 'oa', 'oan', 'tg', 'tn', 'u'])
        && isStr(request.resource.data.n, 80)
        && request.resource.data.n.size() > 0
        && isStr(request.resource.data.r, 20)
        && isStr(request.resource.data.o, 120)
        && isStr(request.resource.data.c, 2)
        && isStr(request.resource.data.b, 400)
        && isStr(request.resource.data.orc, 19)
        && isStr(request.resource.data.oa, 20)
        && isStr(request.resource.data.oan, 120)
        && request.resource.data.tg is list && request.resource.data.tg.size() <= 5
        && request.resource.data.tn is list && request.resource.data.tn.size() <= 5
        && request.resource.data.u == request.time;
    }

    // ---------------------------------------------------------------
    // Переписки. id = uid1_uid2 (по алфавиту), поэтому у пары одна переписка.
    // ---------------------------------------------------------------
    match /conversations/{cid} {

      function members() {
        return resource.data.members;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function other(m) {
        return m[0] == request.auth.uid ? m[1] : m[0];
      }

      // Краткая копия последнего сообщения для списка переписок.
      function validLast(l) {
        return l is map
          && l.keys().hasOnly(['t', 'from', 'at'])
          && isStr(l.t, 200)
          && l.from == request.auth.uid
          && l.at == request.time;
      }

      // Открыть одну переписку (даже ещё не созданную, чтобы узнать, есть ли она)
      // можно только по своей паре: id состоит из uid обоих участников.
      allow get: if signedIn() && request.auth.uid in cid.split('_');
      // Список — только свои переписки (запрос с members array-contains).
      allow list: if isMember();

      // Создать может только участник с опубликованным профилем и только
      // с тем, у кого тоже опубликован профиль. Сразу статус «запрос».
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['members', 'status', 'requester', 'first', 'created', 'updated',
              'last', 'lastRead', 'blockedBy'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && hasProfile(request.auth.uid)
        && hasProfile(other(request.resource.data.members))
        && request.resource.data.status == 'pending'
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.first is string
        && request.resource.data.created == request.time
        && request.resource.data.updated == request.time
        && validLast(request.resource.data.last)
        && request.resource.data.lastRead.keys().hasOnly([request.auth.uid])
        && request.resource.data.blockedBy == [];

      allow update: if isMember()
        && request.resource.data.members == resource.data.members
        && request.resource.data.requester == resource.data.requester
        && request.resource.data.first == resource.data.first
        && request.resource.data.created == resource.data.created
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updated', 'last', 'lastRead', 'blockedBy'])
        // Статус меняет только получатель запроса: принять или отклонить.
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending'
                && request.auth.uid != resource.data.requester
                && request.resource.data.status in ['accepted', 'declined']))
        // Отметку «прочитано» каждый ставит только себе.
        && request.resource.data.lastRead.diff(resource.data.lastRead)
             .affectedKeys().hasOnly([request.auth.uid])
        && (!('lastRead' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastRead[request.auth.uid] == request.time)
        // Блокировка: каждый добавляет или убирает только себя.
        && request.resource.data.blockedBy.toSet()
             .difference(resource.data.blockedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.blockedBy.toSet()
             .difference(request.resource.data.blockedBy.toSet()).hasOnly([request.auth.uid])
        // Последнее сообщение меняется только вместе с отправкой сообщения.
        && (!('last' in request.resource.data.diff(resource.data).affectedKeys())
            || (validLast(request.resource.data.last)
                && request.resource.data.updated == request.time))
        && (!('updated' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.updated == request.time);

      // Участник может удалить переписку («Удалить мои данные»).
      allow delete: if isMember();

      match /messages/{mid} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(cid)).data;
        }

        function convAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(cid)).data;
        }

        allow read: if signedIn() && request.auth.uid in conv().members;

        // Отправка: текст 1–2000 символов, время ставит сервер.
        // До принятия запроса — только одно сообщение от автора запроса
        // (то, чей id записан в поле first). Заблокированным писать нельзя.
        allow create: if signedIn()
          && request.auth.uid in convAfter().members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time
          && convAfter().blockedBy.size() == 0
          && convAfter().status != 'declined'
          && (convAfter().status == 'accepted'
              || (convAfter().requester == request.auth.uid
                  && convAfter().first == mid));

        // Сообщения не редактируются. Удалить может участник переписки.
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid in conv().members;
      }
    }

    // ---------------------------------------------------------------
    // Жалобы на сообщения. Только создание; читает владелец в консоли.
    // ---------------------------------------------------------------
    match /reports/{rid} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['reporter', 'cid', 'mid', 'author', 'text', 'reason', 'at'])
        && request.resource.data.reporter == request.auth.uid
        && isStr(request.resource.data.cid, 200)
        && isStr(request.resource.data.mid, 100)
        && isStr(request.resource.data.author, 128)
        && isStr(request.resource.data.text, 2000)
        && isStr(request.resource.data.reason, 300)
        && request.resource.data.at == request.time
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.cid)).data.members;
    }

    // ---------------------------------------------------------------
    // Канбан-доски. Роли: owner (владелец, поле ow), editor, viewer.
    // Читают все участники, меняют карточки владелец и редакторы,
    // участниками и ролями управляет только владелец.
    // ---------------------------------------------------------------
    match /boards/{bid} {

      function d() {
        return request.resource.data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.mb;
      }

      function isOwner() {
        return signedIn() && resource.data.ow == request.auth.uid;
      }

      function changed() {
        return d().diff(resource.data).affectedKeys();
      }

      function validBoard() {
        return d().keys().hasOnly(
               ['n', 'c', 'ic', 'ow', 'mb', 'rl', 'cols', 'lbs', 'ar', 'tpl', 'cr', 'up'])
          && d().n is string && d().n.size() > 0 && d().n.size() <= 80
          && d().c is int && d().c >= 0 && d().c < 12
          && isStr(d().ic, 20)
          && d().mb is list && d().mb.size() >= 1 && d().mb.size() <= 20
          && d().ow in d().mb
          && d().rl is map
          && d().rl.keys().toSet() == d().mb.toSet()
          && d().rl.values().toSet().hasOnly(['owner', 'editor', 'viewer'])
          && d().rl[d().ow] == 'owner'
          && d().cols is list && d().cols.size() >= 1 && d().cols.size() <= 12
          && d().lbs is list && d().lbs.size() <= 20
          && d().ar is bool
          && isStr(d().tpl, 20)
          && d().up == request.time;
      }

      allow get, list: if isMember();

      allow create: if signedIn()
        && validBoard()
        && d().ow == request.auth.uid
        && d().mb == [request.auth.uid]
        && d().cr == request.time;

      allow update: if isMember()
        && validBoard()
        && d().cr == resource.data.cr
        && (
          // Владелец: всё, в том числе участники, роли и передача владения.
          isOwner()
          // Редактор: название, цвет, иконка, колонки, метки, архив.
          || (resource.data.rl[request.auth.uid] == 'editor'
              && changed().hasOnly(['n', 'c', 'ic', 'cols', 'lbs', 'ar', 'up']))
          // Любой участник, кроме владельца, может выйти из доски.
          || (d().ow == resource.data.ow
              && changed().hasOnly(['mb', 'rl', 'up'])
              && !(request.auth.uid in d().mb)
              && resource.data.mb.toSet().difference(d().mb.toSet())
                   .hasOnly([request.auth.uid]))
        );

      allow delete: if isOwner();

      function board() {
        return get(/databases/$(database)/documents/boards/$(bid)).data;
      }

      function canRead() {
        return signedIn() && request.auth.uid in board().mb;
      }

      // Для записей доску читаем через getAfter: доска и стартовые карточки
      // создаются одним пакетом, и get() ещё не видит новую доску.
      // Изменения самой доски проверяются её собственными правилами выше.
      function boardAfter() {
        return getAfter(/databases/$(database)/documents/boards/$(bid)).data;
      }

      function canEdit() {
        return signedIn() && boardAfter() != null
          && request.auth.uid in boardAfter().mb
          && boardAfter().rl[request.auth.uid] in ['owner', 'editor'];
      }

      match /cards/{cid} {
        function c() {
          return request.resource.data;
        }

        function validCard() {
          return c().keys().hasOnly(
                 ['t', 'd', 'col', 'o', 'due', 'p', 'lb', 'as', 'ck', 'pp', 'gr',
                  'by', 'cr', 'up', 'dn', 'ft'])
            && c().t is string && c().t.size() > 0 && c().t.size() <= 200
            && isStr(c().d, 5000)
            && isStr(c().col, 40)
            && c().o is number
            && (c().due == null || c().due is timestamp)
            && c().p is int && c().p >= 0 && c().p <= 3
            && c().lb is list && c().lb.size() <= 20
            && c().as is list && c().as.size() <= 20
            && c().ck is list && c().ck.size() <= 50
            && c().pp is list && c().pp.size() <= 20
            && c().gr is list && c().gr.size() <= 10
            && (c().dn == null || c().dn is timestamp)
            && c().get('ft', {}) is map && c().get('ft', {}).size() <= 20
            && c().up == request.time;
        }

        // Время фокуса ft: uid → секунды. Каждый меняет только своё время,
        // только в сторону увеличения и не больше чем на 4 часа за раз.
        function validFocus() {
          let old = resource.data.get('ft', {});
          let now = c().get('ft', {});
          let me = request.auth.uid;
          return now.diff(old).affectedKeys().hasOnly([me])
            && (!(me in now)
                || (now[me] is int
                    && now[me] >= old.get(me, 0)
                    && now[me] - old.get(me, 0) <= 14400));
        }

        allow read: if canRead();
        allow create: if canEdit() && validCard()
          && c().by == request.auth.uid
          && c().cr == request.time
          && c().get('ft', {}).size() == 0;
        allow update: if canEdit() && validCard()
          && c().by == resource.data.by
          && c().cr == resource.data.cr
          && validFocus();
        allow delete: if canEdit();

        match /comments/{mid} {
          allow read: if canRead();
          allow create: if canEdit()
            && request.resource.data.keys().hasOnly(['by', 't', 'at'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.t is string
            && request.resource.data.t.size() > 0
            && request.resource.data.t.size() <= 2000
            && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if signedIn()
            && (resource.data.by == request.auth.uid
                || board().ow == request.auth.uid);
        }
      }

      match /activity/{aid} {
        allow read: if canRead();
        allow create: if canEdit()
          && request.resource.data.keys().hasOnly(
               ['by', 'k', 'card', 'ct', 'from', 'to', 'at'])
          && request.resource.data.by == request.auth.uid
          && isStr(request.resource.data.k, 20)
          && isStr(request.resource.data.card, 40)
          && isStr(request.resource.data.ct, 200)
          && isStr(request.resource.data.from, 80)
          && isStr(request.resource.data.to, 80)
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if signedIn() && board().ow == request.auth.uid;
      }
    }

    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
